# Existing V2.3 secret can bootstrap the first admin account if ADMIN_PASSWORD is omitted.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
APP_PASSWORD=YOUR_EXISTING_V2_3_APP_PASSWORD
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SET_A_NEW_STRONG_PASSWORD_AT_LEAST_16_CHARS
SESSION_SECRET=SET_A_RANDOM_SECRET_AT_LEAST_32_CHARS
